# Staging Environment Template — Copy to backend/.env.staging (gitignored).
# Database isolation guard enforces that the connected database name must be strictly 'yara_staging'.

YARA_ENVIRONMENT=staging
DEBUG=false
LOG_LEVEL=INFO

# Staging Database: connects strictly to 'yara_staging'
STAGING_DATABASE_URL=postgres://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/yara_staging
DATABASE_URL=postgres://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/yara_staging

# Staging Secret Key (Must be at least 50 chars and unique to staging)
SECRET_KEY=change-me-staging-secret-key-at-least-50-chars-random

# Media & Storage isolation
# MEDIA_ROOT=/path/to/staging/media

# LiveKit Staging WebRTC (if applicable)
COMMUNICATION_PROVIDER=livekit
LIVEKIT_URL=wss://yara-care-8qxaz9wd.livekit.cloud
LIVEKIT_API_KEY=YOUR_STAGING_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=YOUR_STAGING_LIVEKIT_API_SECRET
