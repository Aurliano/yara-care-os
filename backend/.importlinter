[importlinter]
root_packages =
    config
    common
    domains
    architecture

[importlinter:contract:common-isolation]
name = Common infrastructure must not import domain apps
type = forbidden
source_modules =
    common
forbidden_modules =
    domains

[importlinter:contract:domain-layers]
name = Domain dependency direction
type = layers
layers =
    domains.licensing
    domains.identity_access
    domains.scheduling
    domains.event

[importlinter:contract:identity-access-independence]
name = Identity & Access must not import other domain apps
type = forbidden
source_modules =
    domains.identity_access
forbidden_modules =
    domains

[importlinter:contract:event-independence]
name = Event must not import producer or consumer domain apps
type = forbidden
source_modules =
    domains.event
forbidden_modules =
    domains.identity_access
    domains.licensing
    domains.scheduling

[importlinter:contract:scheduling-independence]
name = Scheduling must not import Care, Workflow, Device, Communication, or Synchronization
type = forbidden
source_modules =
    domains.scheduling
forbidden_modules =
    domains.identity_access
    domains.licensing
