[importlinter]
root_packages =
    config
    common
    domains
    architecture

[importlinter:contract:common-isolation]
name = Common infrastructure must not import domain apps
type = forbidden
source_modules =
    common
forbidden_modules =
    domains

[importlinter:contract:domain-layers]
name = Domain dependency direction
type = layers
layers =
    domains.device
    domains.communication
    domains.licensing
    domains.care
    domains.identity_access
    domains.workflow
    domains.scheduling
    domains.event

[importlinter:contract:identity-access-independence]
name = Identity & Access must not import other domain apps
type = forbidden
source_modules =
    domains.identity_access
forbidden_modules =
    domains

[importlinter:contract:event-independence]
name = Event must not import producer or consumer domain apps
type = forbidden
source_modules =
    domains.event
forbidden_modules =
    domains.identity_access
    domains.licensing
    domains.scheduling
    domains.workflow
    domains.care
    domains.device
    domains.communication

[importlinter:contract:scheduling-independence]
name = Scheduling must not import Care, Workflow, Device, Communication, or Synchronization
type = forbidden
source_modules =
    domains.scheduling
forbidden_modules =
    domains.identity_access
    domains.licensing
    domains.workflow
    domains.care
    domains.device
    domains.communication

[importlinter:contract:workflow-independence]
name = Workflow must not import Care, Device, Communication, Notification, or Synchronization internals
type = forbidden
source_modules =
    domains.workflow
forbidden_modules =
    domains.identity_access
    domains.licensing
    domains.care
    domains.device
    domains.communication
    domains.notification
    domains.synchronization

[importlinter:contract:device-independence]
name = Device must not import Care, Workflow, Communication, Notification, or Synchronization
type = forbidden
source_modules =
    domains.device
forbidden_modules =
    domains.care
    domains.workflow
    domains.communication
    domains.notification
    domains.synchronization

[importlinter:contract:communication-independence]
name = Communication must not import Workflow, Care, Device, Notification, or Synchronization
type = forbidden
source_modules =
    domains.communication
forbidden_modules =
    domains.workflow
    domains.care
    domains.device
    domains.notification
    domains.synchronization

[importlinter:contract:care-independence]
name = Care must not import Licensing, Device, Communication, Notification, or Synchronization
type = forbidden
source_modules =
    domains.care
forbidden_modules =
    domains.licensing
    domains.device
    domains.communication
    domains.notification
    domains.synchronization
