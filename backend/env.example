# Copy to backend/.env (gitignored). Never commit real secrets.
SECRET_KEY=dev-secret-change-me-use-at-least-32-chars
DEBUG=true

# Password here must be the same one `createdb -U postgres` accepts.
# `postgres:postgres` is only a placeholder — Django does not prompt.
# If the password has @ : / # ?, URL-encode it.
DATABASE_URL=postgres://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/yara
TEST_DATABASE_URL=postgres://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/yara_test

# Skyroom API key stays on the Backend only. Never put this in Hub or Family apps.
# The key is 50 characters. Restart the server after editing this file, and note
# that an OS environment variable of the same name overrides what is written here.
# Empty key makes POST /communication/call/start/ return 502 PROVIDER_NOT_CONFIGURED.
# Verify with: python manage.py check_skyroom
SKYROOM_API_KEY=
SKYROOM_API_BASE_URL=https://www.skyroom.online/skyroom/api
COMMUNICATION_PROVIDER=skyroom
# Only set when the Skyroom account has more than one active service.
# SKYROOM_SERVICE_ID=8230
