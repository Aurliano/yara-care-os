# Django
YARA_ENVIRONMENT=development
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (development)
DATABASE_URL=postgres://yara:yara@localhost:5432/yara

# PostgreSQL (tests — optional override)
# TEST_DATABASE_URL=postgres://yara:yara@localhost:5432/yara_test

# CORS (comma-separated origins; production uses env list)
CORS_ALLOWED_ORIGINS=

# Logging
LOG_LEVEL=INFO

# Production only
# SECURE_SSL_REDIRECT=True
