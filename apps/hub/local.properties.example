# Copy to local.properties (gitignored) for a physical Hub tablet on the lab LAN.
# Emulator default (when unset): http://10.0.2.2:8000/api/v1/
hub.backend.url=http://192.168.1.101:8000/api/v1/

# Authenticate as the Family lab caregiver so DeviceAssignment binds to that elder.
# Seed with: python manage.py seed_family_lab
# These values only prefill the Hub caregiver login screen. They are not auto-submitted.
# Leave unset to type the caregiver phone and password on the Hub.
hub.provision.phone=+989121111111
hub.provision.password=familylab123
