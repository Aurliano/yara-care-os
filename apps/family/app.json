{
  "expo": {
    "name": "SAYDA",
    "slug": "sayda-family",
    "scheme": "sayda-family",
    "version": "0.1.5",
    "orientation": "portrait",
    "icon": "./assets/images/sayda-icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#F4F0E7"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ir.sayda.yara.family"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/sayda-icon.png",
        "backgroundColor": "#F4F0E7"
      },
      "package": "ir.sayda.yara.family"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-localization",
      "@livekit/react-native-expo-plugin",
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera to make video calls.",
          "microphonePermission": "Allow $(PRODUCT_NAME) to access your microphone to make voice and video calls."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "supportsRTL": true,
      "forcesRTL": true
    }
  }
}
