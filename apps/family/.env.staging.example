# ==============================================================================
# الگوی پیکربندی محیط Staging برای اپلیکیشن خانواده (Family App)
# TEMPLATE: Family App Staging Configuration
# ==============================================================================
# این فایل صرفاً یک الگو (Example) است و باید در مخزن Git نگهداری شود.
# برای استفاده، این فایل را در مسیر apps/family/.env.staging یا apps/family/.env کپی کنید.
# توجه: فایل‌های .env و .env.staging واقعی حاوی تنظیمات محیطی محلی هستند و در .gitignore قرار دارند.
#
# آدرس پایه API محیط Staging:
# - برای دستگاه فیزیکی در شبکه محلی آزمایشگاه (Physical QA over LAN):
#   از IP سرور Staging بر روی پورت 8000 استفاده کنید (مثال: http://10.254.230.230:8000/api/v1)
# - برای شبیه‌ساز اندروید (Android Emulator):
#   http://10.0.2.2:8000/api/v1
# - برای شبیه‌ساز iOS یا وب محلی:
#   http://localhost:8000/api/v1
# ==============================================================================

EXPO_PUBLIC_API_BASE_URL=http://10.254.230.230:8000/api/v1
